VITE_API_BASE_URL=http://localhost:8000

# Google Sign-In (GeLearn login/register). Without this, GoogleLoginButton
# renders nothing — no error, no fallback, just an empty spot. Get a Client ID
# from Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application), with Authorized JavaScript origins covering this
# dev server (http://localhost:5173) and the real GeLearn domain in prod.
# Must match GOOGLE_OAUTH_CLIENT_ID in backend/.env.example.
VITE_GOOGLE_OAUTH_CLIENT_ID=

# GeLearn subdomain URLs — used for cross-linking between the marketing site and
# the GeLearn app. Only needed for production/staging deploys; in local dev,
# leave these unset and use the built-in "?shell=gelearn" / "?shell=marketing"
# URL toggle instead (see frontend/src/lib/host.ts) to preview both shells on
# a single dev server.
VITE_GELEARN_URL=https://gelearn.genextechnocrats.com
VITE_MARKETING_URL=https://genextechnocrats.com
