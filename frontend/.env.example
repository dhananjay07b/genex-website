VITE_API_BASE_URL=http://localhost:8000

# GeLearn subdomain URLs — used for cross-linking between the marketing site and
# the GeLearn app. Only needed for production/staging deploys; in local dev,
# leave these unset and use the built-in "?shell=gelearn" / "?shell=marketing"
# URL toggle instead (see frontend/src/lib/host.ts) to preview both shells on
# a single dev server.
VITE_GELEARN_URL=https://gelearn.genextechnocrats.com
VITE_MARKETING_URL=https://genextechnocrats.com
