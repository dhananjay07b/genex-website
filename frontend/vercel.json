{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mail.genextechnocrats.com"
        }
      ],
      "destination": "https://mail.hostinger.com",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "gelearn.genextechnocrats.com"
        }
      ],
      "destination": "/gelearn-sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "gelearn.genextechnocrats.com"
        }
      ],
      "destination": "/gelearn-robots.txt"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}