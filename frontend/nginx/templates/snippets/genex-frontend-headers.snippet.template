# Security headers for the two frontend sites. Filled in at startup into
# /etc/nginx/conf.d/snippets/ (a .snippet, so conf.d/*.conf doesn't load it on its own).
# Included at server level: a location that sets its own add_header would drop these,
# so locations set caching with `expires` instead.

# HTTPS only, remembered for a year. includeSubDomains stays off until every
# *.genextechnocrats.com host serves HTTPS (it's hard to undo), as in production.py.
add_header Strict-Transport-Security "max-age=31536000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "strict-origin-when-cross-origin" always;
add_header X-Frame-Options "DENY" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;

# Where the pages may load things from. Report-only for now: browsers log what it
# would block (DevTools console) but block nothing. Once a few weeks show no
# legitimate violations, rename the header to Content-Security-Policy to enforce it.
# - No inline scripts: Google Analytics is loaded by the app, and only after the
#   visitor allows it in the cookie banner (frontend/src/lib/consent.ts).
# - ${CMS_HOST}: the API and CMS uploads.
# - analytics.google.com, stats.g.doubleclick.net: where Google Analytics sends page views.
# - img-src https: images in CMS rich text may come from any HTTPS site.
# - media-src https: videos and podcast audio can be hosted elsewhere.
add_header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://accounts.google.com/gsi/style; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https://${CMS_HOST} https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.googletagmanager.com https://accounts.google.com/gsi/; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://accounts.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'" always;
