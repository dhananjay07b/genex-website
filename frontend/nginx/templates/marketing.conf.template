# Marketing site: ${MARKETING_HOST} (www. redirects here).
# The SAME built frontend as GeLearn; the app shows the marketing shell because
# this hostname isn't the GeLearn one (frontend/src/lib/host.ts).

server {
    listen 80;
    server_name ${MARKETING_HOST} www.${MARKETING_HOST};
    return 301 https://${MARKETING_HOST}$request_uri;
}

# One address for the site: www is a permanent redirect, not a second copy.
server {
    listen 443 ssl;
    http2 on;
    server_name www.${MARKETING_HOST};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    include snippets/genex-common.conf;

    return 301 https://${MARKETING_HOST}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${MARKETING_HOST};

    ssl_certificate     /etc/letsencrypt/live/${CERT_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${CERT_NAME}/privkey.pem;
    include snippets/genex-common.conf;
    include conf.d/snippets/genex-frontend-headers.snippet;
    include snippets/seo-marketing-${SEO_MODE}.conf;

    include snippets/genex-frontend-files.conf;
}
