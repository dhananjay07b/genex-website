# Copy to backend/.env for local dev (already git-ignored). In production,
# these are set as real environment variables instead — this file is loaded
# automatically by genex/settings/base.py via python-dotenv.

# Google Sign-In (GeLearn login/register). Without these, GoogleLoginButton on
# the frontend renders nothing (no error). Get a Client ID + Secret from
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application), with Authorized JavaScript origins covering
# http://localhost:5173 (dev) and the real GeLearn domain in prod.
# GOOGLE_OAUTH_CLIENT_ID must match VITE_GOOGLE_OAUTH_CLIENT_ID in frontend/.env.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Base URL of the GeLearn React app — emailed links (password reset, email
# verification) point here. Defaults to http://localhost:5173 for dev.
GELEARN_FRONTEND_URL=http://localhost:5173

# --- Production-only (unused by genex.settings.dev, the local default) ---
# DJANGO_SECRET_KEY=   (required, 50+ random characters; the server won't start without it)
# ALLOWED_HOSTS=       (required, comma-separated domains)
# CORS_ALLOWED_ORIGINS=
# WAGTAILADMIN_BASE_URL=
# COOKIE_DOMAIN=        (".genextechnocrats.com" so the frontends can read the CSRF cookie set by the API)
# NUM_PROXIES=1         (reverse proxies in front of Django, any server software; 0 if none)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Email: your provider's SMTP details. Leave EMAIL_HOST empty locally to print
# emails in the terminal instead; set it to really send (required in production).
# Test with:  python manage.py send_test_email you@example.com
# Hostinger: EMAIL_HOST=smtp.hostinger.com, EMAIL_PORT=465, user = the full mailbox address.
# EMAIL_HOST=
# EMAIL_PORT=465        (465 = SSL, 587 = STARTTLS; chosen automatically from the port)
# EMAIL_HOST_USER=      (e.g. no-reply@genextechnocrats.com)
# EMAIL_HOST_PASSWORD=  (that mailbox's password)
# DEFAULT_FROM_EMAIL=   ("GeLearn by Genex <no-reply@genextechnocrats.com>"; Hostinger requires this to be the same mailbox as EMAIL_HOST_USER)
# ENQUIRY_EMAIL=        (where Contact form and job applications are sent; default info@genextechnocrats.com)
