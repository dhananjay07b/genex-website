# Copy to backend/.env.production on the server (git-ignored) and fill in real
# values. docker-compose.yml passes it to the backend container. Only secrets live
# here: hostnames, CORS, email links, cookie domain and the database connection are
# set by docker-compose.yml from the root .env (deploy/compose.env.example).

# 50+ random characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Email: the provider's SMTP details. Required: the backend refuses to start
# without EMAIL_HOST. Test after deploying with:
#   docker compose exec backend python manage.py send_test_email you@example.com
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=GeLearn by Genex <no-reply@genextechnocrats.com>
# Where Contact form enquiries are sent.
ENQUIRY_EMAIL=connect@genextechnocrats.com

# Google Sign-In secret (the client ID is in the root .env).
GOOGLE_OAUTH_CLIENT_SECRET=
