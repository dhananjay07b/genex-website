# Copy to /var/www/genex/backend/.env on the server (outside git) and fill in
# real values. Loaded into the process by systemd's EnvironmentFile= directive
# in genex-backend.service — Django reads these via os.environ.get() in
# backend/genex/settings/production.py.

DJANGO_SECRET_KEY=change-me-to-a-real-random-secret

ALLOWED_HOSTS=cms.genextechnocrats.com

CORS_ALLOWED_ORIGINS=https://genextechnocrats.com,https://gelearn.genextechnocrats.com
# Add https://genextechnocrats.vercel.app to the list above only while the
# temporary pre-launch frontend is still on Vercel.

WAGTAILADMIN_BASE_URL=https://cms.genextechnocrats.com

# Google OAuth (see backend/genex/settings/base.py SOCIALACCOUNT_PROVIDERS)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
