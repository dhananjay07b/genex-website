# Copy to `.env` next to docker-compose.yml on the server (git-ignored) and fill in.
# Docker Compose reads it automatically. See deploy/README.md.

# --- Hostnames -----------------------------------------------------------------
# The test sites now; going live means changing these three (plus SEO_MODE below),
# then rebuilding and restarting: see "Going live" in deploy/README.md.
MARKETING_HOST=test.genextechnocrats.com
GELEARN_HOST=test-gelearn.genextechnocrats.com
CMS_HOST=cms.genextechnocrats.com

# hidden: robots.txt blocks everything and pages say noindex (the test sites).
# indexable: the real robots.txt and sitemaps (the live sites).
SEO_MODE=hidden

# Shared by both frontend sites and the API, so sign-in works across them.
COOKIE_DOMAIN=.genextechnocrats.com

# The Let's Encrypt certificate covering all the hostnames above (certbot --cert-name).
CERT_NAME=genex

# --- Database ------------------------------------------------------------------
# Used to create the database on first start and by the backend to connect.
POSTGRES_DB=genex
POSTGRES_USER=genex
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# --- Google Sign-In --------------------------------------------------------------
# The OAuth client ID (public; it's built into the frontend). The secret goes in
# backend/.env.production. Leave empty to hide the Google button.
GOOGLE_OAUTH_CLIENT_ID=

# --- Server behaviour --------------------------------------------------------------
# Start the containers again after a crash or a reboot. Leave unset on a laptop.
RESTART_POLICY=unless-stopped
