# Build context for docker/nginx/Dockerfile (the repo root). Only the frontend
# source and the Nginx config go in; everything else, secrets above all, stays out.
# (The backend image builds from backend/ and has its own backend/.dockerignore.)
*
!frontend/
!docker/nginx/

frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.*
frontend/*.local
**/.DS_Store
