# The project's only .gitignore — backend, frontend and tooling.
# (frontend/.husky/_/ has its own, generated by Husky on npm install: leave it.)

# Claude Code working files
.claude/

# Local environment files — never committed; the tracked .env.example files are the templates
.env
.env.*
!.env.example

# ── Backend (Django / Python) ──────────────────────────────────────────────
backend/venv/
backend/**/__pycache__/
backend/**/*.pyc
backend/db.sqlite3
backend/db.sqlite3.bak-*
backend/*.dump
backend/media/
backend/private/
backend/staticfiles/

# ── Frontend (Vite / React) ────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/*.local

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Editors and OS ─────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ── Local-only material ────────────────────────────────────────────────────
# References
solarlive-reference/
# Raw brand files dropped in for placement (copies live in frontend/public/brand)
brand-incoming/
